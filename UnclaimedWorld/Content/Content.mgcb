
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:Windows
/config:
/profile:HiDef
/compress:True

#-------------------------------- References --------------------------------#

/reference:..\..\SpriteSheetPipeline\bin\Debug\SpriteSheetPipeline.dll
/reference:..\..\SpriteEffectsPipeline\bin\Debug\SpriteEffectsPipeline.dll

#---------------------------------- Content ---------------------------------#

#begin Sounds/activities/weapons/arrowImpact1a.wav
/importer:WavImporter
/processor:SoundEffectProcessor
/processorParam:Quality=Best
/build:Sounds/activities/weapons/arrowImpact1a.wav

#begin TimeOfDayAndLightsources.fx
/importer:EffectImporter
/processor:EffectProcessor
